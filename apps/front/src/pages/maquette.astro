---
export const prerender = true

import { APP_NAME } from '@elance/contracts'

import BaseLayout from '../layouts/BaseLayout.astro'
import MockupPhone from '../features/maquette/MockupPhone.astro'
import ScreenDashboard from '../features/maquette/screen-dashboard.astro'
import ScreenOnboarding from '../features/maquette/screen-onboarding.astro'
import ScreenSettings from '../features/maquette/screen-settings.astro'
import ScreenWeek from '../features/maquette/screen-week.astro'
import ScreenWeight from '../features/maquette/screen-weight.astro'
---

<BaseLayout title="Maquette mobile">
	<main class="mx-auto max-w-7xl px-6 py-12 sm:px-8">
		<header class="mb-10 max-w-2xl">
			<h1 class="text-3xl font-medium tracking-[-0.04em] sm:text-4xl">
				Maquette mobile
			</h1>
			<p class="mt-3 text-muted-foreground">
				Parcours utilisateur de {APP_NAME} sur cinq écrans. Données
				synthétiques, écrans statiques.
			</p>
		</header>
		<div class="flex flex-wrap justify-center gap-x-8 gap-y-12">
			<figure class="w-[340px]">
				<MockupPhone>
					<ScreenOnboarding />
				</MockupPhone>
				<figcaption class="mt-4 text-center text-sm font-medium">
					1 · Onboarding
				</figcaption>
			</figure>
			<figure class="w-[340px]">
				<MockupPhone current="today">
					<ScreenDashboard />
				</MockupPhone>
				<figcaption class="mt-4 text-center text-sm font-medium">
					2 · Aujourd'hui
				</figcaption>
			</figure>
			<figure class="w-[340px]">
				<MockupPhone current="today">
					<ScreenWeek />
				</MockupPhone>
				<figcaption class="mt-4 text-center text-sm font-medium">
					3 · Semaine
				</figcaption>
			</figure>
			<figure class="w-[340px]">
				<MockupPhone current="weight">
					<ScreenWeight />
				</MockupPhone>
				<figcaption class="mt-4 text-center text-sm font-medium">
					4 · Poids
				</figcaption>
			</figure>
			<figure class="w-[340px]">
				<MockupPhone current="settings">
					<ScreenSettings />
				</MockupPhone>
				<figcaption class="mt-4 text-center text-sm font-medium">
					5 · Réglages
				</figcaption>
			</figure>
		</div>
	</main>
</BaseLayout>
