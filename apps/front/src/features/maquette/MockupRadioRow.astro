---
interface Props {
	label: string
	hint?: string
	checked?: boolean
	compact?: boolean
}

const { label, hint, checked = false, compact = false } = Astro.props
---

<div
	class:list={[
		'flex items-center rounded-2xl border',
		compact ? 'min-h-12 gap-2.5 px-3 py-2' : 'min-h-14 gap-3 px-4 py-3',
		checked ? 'border-foreground bg-card' : 'border-border bg-background',
	]}
>
	<span
		class:list={[
			'flex aspect-square size-4 shrink-0 items-center justify-center rounded-full border',
			checked ? 'border-primary bg-primary' : 'border-input',
		]}
	>
		{
			checked ? (
				<span class="bg-primary-foreground size-2 rounded-full" />
			) : null
		}
	</span>
	<span class="flex min-w-0 flex-col gap-0.5">
		<span class:list={['leading-snug', compact ? 'text-[13px]' : 'text-[15px]']}>
			{label}
		</span>
		{
			hint ? (
				<span
					class:list={[
						'text-muted-foreground font-normal',
						compact ? 'text-[11px] leading-tight' : 'text-[13px]',
					]}
				>
					{hint}
				</span>
			) : null
		}
	</span>
</div>
