---
import { calorieStatus } from '@elance/contracts'

import { WEEKDAY_LETTERS } from '../../lib/weekday-letters'

import type { MockupWeekDay } from './mockup-data'

interface Props {
  days: readonly MockupWeekDay[]
  todayIndex: number
  targetKcal: number
}

const PERCENT = 100
const { days, todayIndex, targetKcal } = Astro.props
---

<nav aria-label="Jours de la semaine" class="mt-4">
	<ol class="grid grid-cols-7 gap-1.5">
		{
			days.map((day, index) => {
				const letter = WEEKDAY_LETTERS[index] ?? ''
				const isToday = index === todayIndex
				const isFuture = day.future === true
				const fillTone =
					!isFuture && day.kcal > 0
						? calorieStatus(day.kcal, targetKcal) === 'surplus'
							? 'bg-warning'
							: 'bg-brand'
						: 'bg-transparent'
				return (
					<li>
						{
							isFuture ? (
								<span class="flex flex-col items-center gap-1.5 rounded-2xl border border-dashed border-border py-2.5 text-muted-foreground">
									<span class="text-xs">{letter}</span>
									<span class="text-base tabular-nums">{day.dayOfMonth}</span>
									<span class="relative h-1 w-6 overflow-hidden rounded-full bg-secondary"></span>
								</span>
							) : (
								<span
									class:list={[
										'flex flex-col items-center gap-1.5 rounded-2xl py-2.5',
										isToday
											? 'bg-foreground text-background'
											: 'bg-card text-muted-foreground',
									]}
								>
									<span class="text-xs">{letter}</span>
									<span
										class:list={[
											'text-base tabular-nums',
											isToday && 'font-semibold',
										]}
									>
										{day.dayOfMonth}
									</span>
									<span
										class:list={[
											'relative h-1 w-6 overflow-hidden rounded-full',
											isToday ? 'bg-white/15' : 'bg-secondary',
										]}
									>
										<span
											class:list={[
												'absolute inset-y-0 left-0 rounded-full',
												fillTone,
											]}
											style={`width: ${Math.min(1, day.kcal / targetKcal) * PERCENT}%`}
										></span>
									</span>
								</span>
							)
						}
					</li>
				)
			})
		}
	</ol>
</nav>
