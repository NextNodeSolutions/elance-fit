---
import { formatNumber } from '../../lib/format/format-number'

import WeekBarChart from '../landing/WeekBarChart.astro'

import MockupHeader from './MockupHeader.astro'
import MockupWeekPills from './MockupWeekPills.astro'
import {
  MOCKUP_TARGET_KCAL,
  MOCKUP_TODAY_INDEX,
  MOCKUP_WEEK_DAYS,
  MOCKUP_WEEK_RANGE,
  MOCKUP_WEEK_STATS,
} from './mockup-data'

const { averageKcal, balancedDays, loggedDays, weightDeltaKg } =
  MOCKUP_WEEK_STATS
const stats = [
  { label: 'Moyenne', value: formatNumber(averageKcal), unit: 'kcal' },
  {
    label: 'Jours équilibrés',
    value: `${balancedDays}/${loggedDays}`,
    unit: null,
  },
  { label: 'Poids', value: formatNumber(weightDeltaKg), unit: 'kg' },
]
---

<MockupHeader />
<div class="flex items-baseline justify-between px-1 pt-1">
	<h1 class="text-[1.6rem] leading-tight font-medium tracking-[-0.04em]">
		Semaine
	</h1>
	<span class="text-xs text-muted-foreground">{MOCKUP_WEEK_RANGE}</span>
</div>
<MockupWeekPills
	days={MOCKUP_WEEK_DAYS}
	todayIndex={MOCKUP_TODAY_INDEX}
	targetKcal={MOCKUP_TARGET_KCAL}
/>
<div class="mt-3 rounded-2xl bg-card p-3.5">
	<dl class="grid grid-cols-3 gap-2">
		{
			stats.map(stat => (
				<div>
					<dt class="text-[11px] text-muted-foreground">{stat.label}</dt>
					<dd class="mt-0.5 text-lg leading-tight font-medium tabular-nums">
						{stat.value}{' '}
						{
							stat.unit ? (
								<span class="text-[11px] font-normal text-muted-foreground">
									{stat.unit}
								</span>
							) : null
						}
					</dd>
				</div>
			))
		}
	</dl>
	<WeekBarChart days={MOCKUP_WEEK_DAYS} targetKcal={MOCKUP_TARGET_KCAL} />
</div>
