---
import { APP_NAME } from '@elance/contracts'
import {
  ACTIVITY_LEVEL_OPTIONS,
  SEX_OPTIONS,
  TEXT_FIELDS,
  UNITS_OPTIONS,
} from '@elance/contracts'
import {
  Button,
  cardDescriptionVariants,
  cardTitleVariants,
  Input,
  Label,
} from '@elance/ui'
import { Copy, LogOut, Trash2 } from 'lucide-react'

import MockupHeader from './MockupHeader.astro'
import MockupRadioRow from './MockupRadioRow.astro'
import { MOCKUP_API_TOKEN, MOCKUP_PROFILE } from './mockup-data'

const FIELD_VALUES: Record<string, string> = {
  height: '170',
  weight: '70',
  age: '30',
}
---

<MockupHeader />
<h1 class="pt-1 text-[1.6rem] leading-tight font-medium tracking-[-0.04em]">
	Réglages
</h1>
<div class="mt-3 space-y-3">
	<div class="rounded-2xl bg-card p-4">
		<h2 class={cardTitleVariants()}>Profil</h2>
		<p class:list={[cardDescriptionVariants(), 'mt-1']}>
			Sert à calculer ta cible calorique et tes macros.
		</p>
		<div class="mt-3 grid grid-cols-3 gap-2">
			{
				TEXT_FIELDS.map(spec => (
					<div class="space-y-1.5">
						<Label
							htmlFor={`mockup-profile-${spec.id}`}
							className="text-[13px]"
						>
							{spec.label}
							<span class="text-muted-foreground font-normal">
								{' '}
								{spec.unit}
							</span>
						</Label>
						<Input
							id={`mockup-profile-${spec.id}`}
							type="number"
							min={spec.min}
							max={spec.max}
							defaultValue={FIELD_VALUES[spec.id]}
							className="px-3"
						/>
					</div>
				))
			}
		</div>
		<div class="mt-3 space-y-2">
			<span id="mockup-profile-sex-label" class="block text-sm font-medium">
				Sexe
			</span>
			<div class="grid grid-cols-2 gap-2">
				{
					SEX_OPTIONS.map(option => (
						<MockupRadioRow
							label={option.label}
							checked={option.value === 'female'}
						/>
					))
				}
			</div>
		</div>
		<div class="mt-3 space-y-2">
			<span
				id="mockup-profile-activity-label"
				class="block text-sm font-medium"
			>
				Niveau d'activité
			</span>
			<div class="grid gap-2">
				{
					ACTIVITY_LEVEL_OPTIONS.map(option => (
						<MockupRadioRow
							label={option.label}
							hint={option.hint}
							checked={option.value === 'moderate'}
							compact
						/>
					))
				}
			</div>
		</div>
	</div>
	<div class="rounded-2xl bg-card p-4">
		<h2 class={cardTitleVariants()}>Unités</h2>
		<div class="mt-3 grid grid-cols-2 gap-2">
			{
				UNITS_OPTIONS.map(option => (
					<MockupRadioRow
						label={option.label}
						checked={option.value === 'metric'}
						compact
					/>
				))
			}
		</div>
	</div>
	<div class="rounded-2xl bg-card p-4">
		<h2 class={cardTitleVariants()}>Branche ton assistant</h2>
		<p class:list={[cardDescriptionVariants(), 'mt-1.5']}>
			ChatGPT, Claude et Gemini : connexion en 1 clic bientôt. En
			attendant, ta clé permet de connecter {APP_NAME} à ton assistant.
		</p>
		<dl class="mt-4">
			<dt class="text-sm font-medium">Ta clé</dt>
			<dd class="mt-2 flex items-center gap-2">
				<code class="border-border bg-background min-w-0 flex-1 rounded-lg border px-4 py-3 font-mono text-[13px] leading-5 break-all">
					{MOCKUP_API_TOKEN}
				</code>
				<Button variant="outline" size="icon" aria-label="Copier la clé">
					<Copy />
				</Button>
			</dd>
		</dl>
	</div>
	<div class="rounded-2xl bg-card p-4">
		<h2 class={cardTitleVariants()}>Compte</h2>
		<p class:list={[cardDescriptionVariants(), 'mt-1']}>
			Connecté avec {MOCKUP_PROFILE.email}
		</p>
		<div class="mt-4">
			<Button variant="outline" className="w-full">
				<LogOut />
				Se déconnecter
			</Button>
		</div>
		<div class="mt-4 border-t border-secondary pt-4">
			<h3 class="text-[15px] font-medium tracking-tight">
				Supprimer mon compte
			</h3>
			<p class="text-muted-foreground mt-1 text-sm">
				Efface ton compte et toutes tes données.
			</p>
			<Button
				variant="outline"
				className="text-destructive hover:border-destructive/40 mt-3"
			>
				<Trash2 />
				Supprimer mon compte
			</Button>
		</div>
	</div>
</div>
