---
import { buildDaySummary } from '@elance/contracts'
import {
  badgeVariants,
  cardHeaderVariants,
  cardTitleVariants,
  Progress,
} from '@elance/ui'

import CalorieStatusBadge from '../../components/nutrition/CalorieStatusBadge.astro'
import { formatNumber } from '../../lib/format/format-number'
import { MACRO_TONES } from '../../lib/macro-tones'

import MockupHeader from './MockupHeader.astro'
import MockupWeekPills from './MockupWeekPills.astro'
import {
  MOCKUP_DAY_LABEL,
  MOCKUP_MEALS,
  MOCKUP_PROFILE,
  MOCKUP_TARGET_KCAL,
  MOCKUP_TODAY_INDEX,
  MOCKUP_WEEK_DAYS,
} from './mockup-data'

const summary = buildDaySummary(
  MOCKUP_TARGET_KCAL,
  MOCKUP_PROFILE.weightKg,
  MOCKUP_MEALS,
)
---

<MockupHeader />
<div class="flex items-baseline justify-between px-1 pt-1">
	<h1 class="text-[1.6rem] leading-tight font-medium tracking-[-0.04em]">
		Aujourd'hui
	</h1>
	<span class="text-xs text-muted-foreground">{MOCKUP_DAY_LABEL}</span>
</div>
<MockupWeekPills
	days={MOCKUP_WEEK_DAYS}
	todayIndex={MOCKUP_TODAY_INDEX}
	targetKcal={MOCKUP_TARGET_KCAL}
/>
<div class="mt-3 rounded-2xl bg-card p-3.5">
	<header class={cardHeaderVariants()}>
		<h2 class={cardTitleVariants()}>Calories</h2>
		<span class="text-xs text-muted-foreground">
			Objectif {formatNumber(MOCKUP_TARGET_KCAL)} kcal
		</span>
	</header>
	<p class="mt-2 flex items-baseline gap-1.5">
		<span class="text-4xl font-medium tracking-[-0.05em] tabular-nums">
			{formatNumber(summary.consumed.calories)}
		</span>
		<span class="text-sm text-muted-foreground">kcal consommées</span>
	</p>
	<Progress
		value={summary.consumed.calories / summary.targetKcal}
		label="Calories consommées par rapport à la cible"
		size="lg"
		tone={summary.status === 'surplus' ? 'warning' : 'brand'}
		className="mt-3"
	/>
	<div class="mt-3 flex flex-wrap gap-2">
		<CalorieStatusBadge status={summary.status} />
		<span class={badgeVariants()}>{summary.remainingMessage}</span>
	</div>
</div>
<ul class="mt-2 grid grid-cols-3 gap-2">
	{
		summary.macros.map(macro => (
			<li class="rounded-2xl bg-card p-2.5">
				<span class="text-[11px] text-muted-foreground">{macro.label}</span>
				<p class="mt-0.5 text-lg leading-tight font-medium tabular-nums">
					{formatNumber(macro.consumedG)} g
				</p>
				<p class="text-[11px] text-muted-foreground">
					sur {formatNumber(macro.targetG)} g
				</p>
				<Progress
					value={macro.targetG > 0 ? macro.consumedG / macro.targetG : 0}
					label={macro.label}
					size="sm"
					tone={MACRO_TONES[macro.key]}
					className="mt-2"
				/>
			</li>
		))
	}
</ul>
<ul class="mt-2 rounded-2xl bg-card px-3 py-0.5">
	{
		MOCKUP_MEALS.map(meal => (
			<li class="flex items-center gap-3 border-b border-border py-2 text-[13px] last:border-0">
				<span class="font-mono text-[11px] text-muted-foreground">
					{meal.time}
				</span>
				<span class="min-w-0 flex-1 truncate">{meal.name}</span>
				<span class="tabular-nums">{meal.calories}</span>
			</li>
		))
	}
</ul>
